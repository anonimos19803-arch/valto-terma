generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String   @default("ΒάΛτο Τέρμα")
  description String   @default("Μια βραδιά γεμάτη ελληνική pop μουσική από τα 2000s")
  date        String   @default("2025-05-24")
  time        String   @default("21:00")
  location    String   @default("")
  totalTables Int      @default(25)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  tableNo   Int
  guests    Int
  notes     String?
  createdAt DateTime @default(now())
}

model Photo {
  id        Int      @id @default(autoincrement())
  filename  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
